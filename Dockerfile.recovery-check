# Disposable operator tools only. Never use this image as the ordering backend.
FROM python:3.12.15-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1 AS python-tools
FROM postgres:18.6-trixie
COPY --from=python-tools /usr/local/ /usr/local/
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /check
RUN groupadd --gid 10001 kpscheck \
    && useradd --uid 10001 --gid kpscheck --create-home --shell /bin/bash kpscheck \
    && install -d -m 0700 -o kpscheck -g kpscheck /home/kpscheck/.ssh
COPY requirements.lock ./requirements.lock
RUN python -m pip install --require-hashes --only-binary=:all: -r requirements.lock \
    && python --version && psql --version && pg_dump --version
COPY --chown=kpscheck:kpscheck . /check/
USER 10001:10001
ENTRYPOINT []
CMD ["python", "tools/render_private_probe.py"]
